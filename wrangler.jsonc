{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Local development uses the top level. Deploy with the "production" env below.
  // Keep your real values out of git: copy this file to wrangler.private.jsonc
  // (gitignored) and run commands with WRANGLER_CONFIG=wrangler.private.jsonc.
  "name": "finance",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-20",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "finance-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "ASSIST_LIMITER", "namespace_id": "1011", "simple": { "limit": 60, "period": 60 } }
  ],
  "vars": {
    "APP_NAME": "Finance",
    "TYPESAFE_MODEL": "jev-latest",
    "OWNER_EMAIL": ""
  },
  "env": {
    "production": {
      "name": "finance",
      // Reachable only on your own domain (put Cloudflare Access in front of it).
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "finance.example.com", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "finance",
          "database_id": "REPLACE_WITH_ID_FROM_wrangler_d1_create",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
        { "name": "ASSIST_LIMITER", "namespace_id": "1011", "simple": { "limit": 60, "period": 60 } }
      ],
      "vars": {
        "APP_NAME": "Finance",
        "TYPESAFE_MODEL": "jev-latest",
        // Only this email can run first-time setup.
        "OWNER_EMAIL": "you@example.com",
        // Cloudflare Access: when both are set, the Worker rejects requests without a valid Access JWT.
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": ""
      }
    }
  }
}
